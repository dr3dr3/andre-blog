{
    // Rename this to match your project after cloning the template.
    "name": "DR3DR3-DEVCONTAINER-TEMPLATE",

    "build": {
        "dockerfile": "Dockerfile"
        // Tool versions are pinned as ARGs at the top of the Dockerfile.
        // Override them here if a single project needs something different, e.g.
        // "args": { "NODE_MAJOR": "22" }
    },

    // workspaceMount and workspaceFolder are deliberately NOT set.
    //
    // This repo is meant to be opened with "Dev Containers: Clone Repository in
    // Container Volume", which puts the working tree on a Docker volume — ext4,
    // native container storage — and mounts it at /workspaces/andre-blog.
    // Pinning workspaceMount to a bind of ${localWorkspaceFolder} would override
    // that and force the tree back onto the host filesystem.
    //
    // Why it matters: on a Windows host the bind mount is v9fs, where a single
    // small file read costs ~12ms. Astro's dev server needs ~48s to become ready
    // there and its file watcher never fires, so it serves stale pages after an
    // edit. The same tree on ext4 is ready in 1s and watches correctly. Builds
    // are fine either way; it is only the dev server that suffers.
    //
    // Opening this folder as a plain bind mount still works — VS Code falls back
    // to its default of /workspaces/<folder> — you just get the slow dev server.
    // See "Local development" in README.md.

    // Bind the host Docker socket (docker-outside-of-docker: the CLI in this
    // container drives the host daemon) and persist state that is expensive to
    // recreate. The named volumes are keyed by ${devcontainerId}, so each repo
    // built from this template gets its own credentials and history.
    //
    // There is no node_modules volume: when the working tree is already on a
    // volume, node_modules is on it too and a separate mount buys nothing. The
    // pnpm store stays on its own volume because it lives outside the tree, in
    // $HOME, which is container-local and wiped on rebuild.
    "mounts": [
        "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind",
        "source=devcontainer-${devcontainerId}-claude,target=/home/dev/.claude,type=volume",
        "source=devcontainer-${devcontainerId}-aws,target=/home/dev/.aws,type=volume",
        "source=devcontainer-${devcontainerId}-history,target=/commandhistory,type=volume",
        "source=devcontainer-${devcontainerId}-pnpm-store,target=/home/dev/.pnpm-store,type=volume"
    ],

    // Astro's dev and preview servers, on 4380 rather than its default 4321 —
    // 4321 is commonly already taken on the host by another editor window or
    // project, and a forward that cannot bind looks exactly like a dead server.
    // Declared explicitly rather than relying on auto-detection, which drops
    // the forward when a server restarts and does not always re-establish it.
    // The port is also set in the dev and preview scripts in package.json.
    "forwardPorts": [4380],
    "portsAttributes": {
        "4380": {
            "label": "astro",
            "onAutoForward": "notify"
        }
    },

    "customizations": {
        "vscode": {
            "extensions": [
                "github.vscode-pull-request-github",
                "github.copilot",
                "github.copilot-chat",
                "anthropic.claude-code",
                "amazonwebservices.aws-toolkit-vscode",
                "esbenp.prettier-vscode",
                "dbaeumer.vscode-eslint",
                "editorconfig.editorconfig",
                "redhat.vscode-yaml",
                "eamodio.gitlens",
                "ms-azuretools.vscode-docker",
                "ms-vscode.live-server"
            ],
            "settings": {
                "editor.fontFamily": "FiraCode Nerd Font, monospace",
                "editor.fontSize": 14,
                "editor.formatOnSave": true,
                "editor.defaultFormatter": "esbenp.prettier-vscode",
                "files.eol": "\n",
                "files.trimTrailingWhitespace": true,
                "files.insertFinalNewline": true,
                "[dockerfile]": {
                    "editor.defaultFormatter": "ms-azuretools.vscode-docker"
                },
                "[yaml]": {
                    "editor.defaultFormatter": "redhat.vscode-yaml"
                },
                "terminal.integrated.defaultProfile.linux": "bash",
                "terminal.integrated.profiles.linux": {
                    "bash": {
                        "path": "/bin/bash"
                    }
                }
            }
        }
    },

    // Set environment variables
    "remoteEnv": {
        "AWS_REGION": "ap-southeast-2",
        // Point pnpm's content-addressable store at its named volume. pnpm 11
        // reads npm-style config from the environment, so this needs no .npmrc.
        "npm_config_store_dir": "/home/dev/.pnpm-store"
        // Uncomment to default the CLI and AWS Toolkit to a named profile:
        // , "AWS_PROFILE": "default"
    },

    // Connect as the non-root user.
    // Hardcoded to match ARG USERNAME=dev in the Dockerfile.
    // If you change the USERNAME build arg, update this value and the /home/dev
    // mount targets above to match.
    "remoteUser": "dev",

    // Git identity is NOT configured here. The Dev Containers extension copies
    // your host ~/.gitconfig into the container on startup, so commits use
    // whoever is running the container. To override for this repo only, run:
    //   git config user.email 'you@example.com'
    //
    // Hand ownership of the named volumes to the dev user and wire up persistent
    // shell history (once, at creation).
    "postCreateCommand": "bash .devcontainer/post-create.sh",

    // Align the container's docker group with the mounted host socket (every start).
    "postStartCommand": "bash .devcontainer/post-start.sh"
}
