---
import SiteFooter from '../components/SiteFooter.astro';
import Analytics from '../components/Analytics.astro';
import '../styles/global.css';

interface Props {
    /** Page title, used verbatim in <title> and og:title. */
    title: string;
    /** Meta description. Keep it to one sentence. */
    description: string;
    /** Set when the post declares a `canonical` in frontmatter. */
    canonical?: string;
    /** Home page only. The header becomes a masthead: the name set large, with
     *  `description` as the line underneath it. Everywhere else keeps the
     *  compact header, because a masthead on a post competes with its title. */
    masthead?: boolean;
}

const { title, description, canonical, masthead = false } = Astro.props;
const url = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en-AU">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={url} />
        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
        <link
            rel="preload"
            href="/fonts/jetbrains-mono-latin.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />
        <link
            rel="preload"
            href="/fonts/newsreader-latin.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />
        <link rel="alternate" type="application/rss+xml" title="André Dreyer" href="/rss.xml" />
        <meta property="og:type" content="website" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={url} />
    </head>
    <body>
        <a class="skip" href="#main">Skip to content</a>
        <header class:list={['site-header', masthead && 'site-header--masthead']}>
            {
                masthead ? (
                    <div class="masthead">
                        {/* The given name carries the weight. JetBrains Mono is loaded
                            variable across 400-700 and the site used exactly one of
                            those weights, so the axis was already paid for. */}
                        <h1 class="masthead-name"><b>André</b> Dreyer</h1>
                        <p class="masthead-line">{description}</p>
                    </div>
                ) : (
                    <a class="site-name" href="/">
                        <b>André</b> Dreyer
                    </a>
                )
            }
            <nav aria-label="Primary">
                <a href="/">Posts</a>
                <a href="/about">About</a>
                <a href="/rss.xml">RSS</a>
            </nav>
        </header>
        <main id="main">
            <slot />
        </main>
        <SiteFooter />
        <Analytics />
    </body>
</html>
