---
import Outcome from './Outcome.astro';
import { isoDate } from '../lib/format';
import type { Post } from '../lib/posts';

interface Props {
    post: Post;
    /**
     * The post's archive number — its position in publication order, oldest
     * first. Stable for the life of the post: publishing a new one does not
     * renumber the ones beneath it, which a rank would.
     */
    number: number;
}

const { post, number } = Astro.props;
---

<li>
    <span class="index-numeral" aria-hidden="true">
        {String(number).padStart(2, '0')}
    </span>
    <p class="index-meta">
        {/* The rule after the label is a flex child of this <p>, so the
            label itself is wrapped: without it every inline here would
            become a flex item and the spacing between them would go. */}
        <span>
            <time datetime={isoDate(post.data.published)}>{isoDate(post.data.published)}</time>
            <span class="sep"> · </span>
            <Outcome
                status={post.data.outcome.status}
                was={post.data.outcome.was}
                changed={post.data.outcome.changed}
            />
        </span>
    </p>
    <a href={`/posts/${post.id}/`}>{post.data.title}</a>
    <p class="summary">{post.data.summary}</p>
</li>
