---
import type { CollectionEntry } from 'astro:content';
import Outcome from './Outcome.astro';
import { isoDate } from '../lib/format';

interface Props {
    data: CollectionEntry<'posts'>['data'];
    /** Estimated reading time in whole minutes. */
    minutes: number;
}

const { data, minutes } = Astro.props;
---

<dl class="post-meta">
    {
        data.context && (
            <>
                <dt>context</dt>
                <dd>{data.context}</dd>
            </>
        )
    }
    {
        data.stack.length > 0 && (
            <>
                <dt>stack</dt>
                <dd>
                    {data.stack.map((item, i) => (
                        <>
                            {i > 0 && <span class="sep"> · </span>}
                            {/* The version is rendered, not hidden in a tooltip.
                                `abbr[title]` is hover-only: it does not exist on a
                                touch device, and its announcement is inconsistent
                                across screen readers. The version is the evidence
                                a post rests on, and READERS.md says most readers
                                arrive by phone — so it was invisible to almost
                                everyone it was for. */}
                            <span>{item.name}</span>
                            {item.version && <span class="stack-version">{item.version}</span>}
                        </>
                    ))}
                </dd>
            </>
        )
    }
    {/* The label links to the glossary. The taxonomy carries the site's only
        colour and was explained on no page a reader could reach. */}
    <dt><a class="meta-help" href="/colophon#what-the-outcomes-mean">outcome</a></dt>
    <dd>
        <Outcome status={data.outcome.status} was={data.outcome.was} changed={data.outcome.changed} />
    </dd>
    <dt>published</dt>
    <dd>
        <time datetime={isoDate(data.published)}>{isoDate(data.published)}</time>
        <span class="sep"> · </span>{minutes} min
        {
            data.updated && (
                <>
                    <span class="sep"> · </span>updated{' '}
                    <time datetime={isoDate(data.updated)}>{isoDate(data.updated)}</time>
                </>
            )
        }
    </dd>
</dl>
