---
import { getDora } from '../lib/dora';

// Computed from git history at build time. An em dash means the number is not
// available, not that it is zero — and metrics 2 to 4 stay quiet until they rest
// on three posts. docs/METRICS.md is the specification; src/lib/dora.ts
// implements it, and /colophon explains it to readers.
const dora = getDora();
---

<footer class="site-footer">
    <p class="metrics">
        <a href="/colophon#the-numbers-in-the-footer">
            deploy freq {dora.deployFrequency} · draft→live {dora.draftToLive} · revised {
                dora.revised
            } · time to revise {dora.timeToRevise}
        </a>
    </p>
    <p><a href="/colophon">Colophon</a></p>
</footer>
