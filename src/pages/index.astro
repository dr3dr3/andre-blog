---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostEntry from '../components/PostEntry.astro';
import { getPosts } from '../lib/posts';

// Reverse-chronological, no pagination. Revisit at 30 posts.
const posts = await getPosts();
---

<BaseLayout
    title="André Dreyer"
    description="Notes on platform engineering, AI agents and the systems around them."
    masthead
>
    <ul class="post-index">
        {
            /* Newest first, but numbered oldest first, so the number is the
               post's place in the archive rather than its place in this list. */
            posts.map((post, i) => <PostEntry post={post} number={posts.length - i} />)
        }
    </ul>
</BaseLayout>
