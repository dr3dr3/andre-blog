---
import BaseLayout from '../layouts/BaseLayout.astro';
import Outcome from '../components/Outcome.astro';
import { getPosts } from '../lib/posts';
import { isoDate } from '../lib/format';

// Reverse-chronological, no pagination. Revisit at 30 posts.
const posts = await getPosts();
---

<BaseLayout
    title="André Dreyer"
    description="Notes on platform engineering, AI agents and the systems around them."
    masthead
>
    <ul class="post-index">
        {
            posts.map((post) => (
                <li>
                    <p class="index-meta">
                        {/* The rule after the label is a flex child of this <p>, so the
                            label itself is wrapped: without it every inline here would
                            become a flex item and the spacing between them would go. */}
                        <span>
                            <time datetime={isoDate(post.data.published)}>{isoDate(post.data.published)}</time>
                            <span class="sep"> · </span>
                            <Outcome
                                status={post.data.outcome.status}
                                was={post.data.outcome.was}
                                changed={post.data.outcome.changed}
                            />
                        </span>
                    </p>
                    <a href={`/posts/${post.id}/`}>{post.data.title}</a>
                    <p class="summary">{post.data.summary}</p>
                </li>
            ))
        }
    </ul>
</BaseLayout>
