---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostEntry from '../components/PostEntry.astro';
import { getArchiveNumbers, getPosts } from '../lib/posts';

/*
 * A 404 is the one page where nobody is mid-article and nothing is interrupted,
 * so it can afford to be useful rather than apologetic. It says what happened
 * in one line and then does the only helpful thing available: shows what is
 * actually here. The archive is short enough that listing all of it is a real
 * answer rather than a consolation link.
 */
const posts = await getPosts();
const numbers = await getArchiveNumbers();
---

<BaseLayout title="Not found — André Dreyer" description="That page does not exist.">
    <article>
        <p class="notfound-code">404</p>
        <h1>Not found</h1>
        <div class="prose">
            <p>
                That address does not exist here — mistyped, or something that moved. Nothing is
                broken on your side. Everything that has been published is below.
            </p>
        </div>
    </article>

    <ul class="post-index notfound-index">
        {posts.map((post) => <PostEntry post={post} number={numbers.get(post.id)!} />)}
    </ul>
</BaseLayout>
