---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostMeta from '../../components/PostMeta.astro';
import PostEntry from '../../components/PostEntry.astro';
import { getPosts, type Post, getArchiveNumbers, getNextToRead } from '../../lib/posts';
import { readingMinutes } from '../../lib/format';

export const getStaticPaths: GetStaticPaths = async () => {
    const posts = await getPosts();
    return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
};

interface Props {
    post: Post;
}

const { post } = Astro.props;
const { Content } = await render(post);
const minutes = readingMinutes(post.body ?? '');
const nextToRead = await getNextToRead(post.id);
const numbers = await getArchiveNumbers();
---

<BaseLayout
    title={post.data.title}
    description={post.data.summary}
    canonical={post.data.canonical}
    ogSlug={post.id}
>
    <article>
        <h1>{post.data.title}</h1>
        <PostMeta data={post.data} minutes={minutes} />
        <div class="prose">
            <Content />
        </div>
        {
            post.data.tags.length > 0 && (
                <p class="post-tags">
                    <span class="post-tags-label">Tagged</span>
                    {post.data.tags.map((tag) => (
                        <a href={`/tags/${tag}/`}>{tag}</a>
                    ))}
                </p>
            )
        }
    </article>
    {
        /* Rendered through PostEntry so it cannot drift from the index, and so
           it carries the same archive number the reader saw there. */
        nextToRead && (
            <section class="read-next" aria-labelledby="read-next">
                <h2 class="label" id="read-next">
                    Read next
                </h2>
                <ul class="post-index">
                    <PostEntry post={nextToRead} number={numbers.get(nextToRead.id)!} />
                </ul>
            </section>
        )
    }
</BaseLayout>
