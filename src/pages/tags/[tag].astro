---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Outcome from '../../components/Outcome.astro';
import { getPosts, getTags, type Post } from '../../lib/posts';
import { isoDate } from '../../lib/format';

export const getStaticPaths: GetStaticPaths = async () => {
    const [posts, tags] = await Promise.all([getPosts(), getTags()]);
    return tags.map((tag) => ({
        params: { tag },
        props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)) },
    }));
};

interface Props {
    tag: string;
    posts: Post[];
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`${tag} — André Dreyer`} description={`Posts tagged ${tag}.`}>
    <h1>{tag}</h1>
    <ul class="post-index">
        {
            posts.map((post) => (
                <li>
                    <p class="index-meta">
                        {/* The rule after the label is a flex child of this <p>, so the
                            label itself is wrapped: without it every inline here would
                            become a flex item and the spacing between them would go. */}
                        <span>
                            <time datetime={isoDate(post.data.published)}>{isoDate(post.data.published)}</time>
                            <span class="sep"> · </span>
                            <Outcome
                                status={post.data.outcome.status}
                                was={post.data.outcome.was}
                                changed={post.data.outcome.changed}
                            />
                        </span>
                    </p>
                    <a href={`/posts/${post.id}/`}>{post.data.title}</a>
                    <p class="summary">{post.data.summary}</p>
                </li>
            ))
        }
    </ul>
</BaseLayout>
