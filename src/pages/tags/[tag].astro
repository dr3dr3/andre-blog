---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostEntry from '../../components/PostEntry.astro';
import { getArchiveNumbers, getPosts, getTags, type Post } from '../../lib/posts';

export const getStaticPaths: GetStaticPaths = async () => {
    const [posts, tags] = await Promise.all([getPosts(), getTags()]);
    return tags.map((tag) => ({
        params: { tag },
        props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)) },
    }));
};

interface Props {
    tag: string;
    posts: Post[];
}

const { tag, posts } = Astro.props;
const numbers = await getArchiveNumbers();
---

<BaseLayout title={`${tag} — André Dreyer`} description={`Posts tagged ${tag}.`}>
    <h1>{tag}</h1>
    <p class="tag-intro">Posts tagged <strong>{tag}</strong>.</p>
    <ul class="post-index">
        {
            /* Through PostEntry, like the index and the 404. This page used to
               hand-duplicate the markup and omitted the numeral, so the claim
               that the listings cannot drift was false the day it was written.
               Numbered by archive position, which is a property of the post
               rather than of this filtered list. */
            posts.map((post) => <PostEntry post={post} number={numbers.get(post.id)!} />)
        }
    </ul>
</BaseLayout>
